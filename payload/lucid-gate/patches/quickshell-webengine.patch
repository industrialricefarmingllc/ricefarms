--- /dev/null
+++ b/src/webengine/webengine.hpp
@@ -0,0 +1,50 @@
+#pragma once
+
+#include <QDebug>
+#include <qlibrary.h>
+#include <qlogging.h>
+
+namespace qs::web_engine {
+
+inline void printNotLoaded() {
+	qWarning() << "QtWebEngineQuick is not loaded. Using WebEngineView from QtWebEngine may "
+	              "behave unpredictably.";
+}
+
+// Loaded at runtime so Quickshell does not hard-depend on qt6-webengine. The
+// pragma //@ pragma EnableQtWebEngineQuick in shell.qml asks for this.
+inline bool init() {
+	using InitializeFunc = void (*)();
+
+	QLibrary lib("Qt6WebEngineQuick");
+	if (!lib.load()) {
+		qWarning() << "Failed to load Qt6WebEngineQuick:" << lib.errorString();
+		qWarning() << "Install qt6-webengine to use WebEngineView.";
+		printNotLoaded();
+		return false;
+	}
+
+	auto initialize = reinterpret_cast<InitializeFunc>(lib.resolve("_ZN16QtWebEngineQuick10initializeEv"));
+	if (!initialize) {
+		qWarning() << "Could not resolve QtWebEngineQuick::initialize()";
+		printNotLoaded();
+		return false;
+	}
+
+	try {
+		initialize();
+		qDebug() << "Initialized QtWebEngineQuick";
+	} catch (const std::exception& e) {
+		qWarning() << "QtWebEngineQuick::initialize() failed:" << e.what();
+		printNotLoaded();
+		return false;
+	} catch (...) {
+		qWarning() << "QtWebEngineQuick::initialize() failed";
+		printNotLoaded();
+		return false;
+	}
+
+	return true;
+}
+
+} // namespace qs::web_engine
