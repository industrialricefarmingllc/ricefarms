[config]
fallback_color = "#89b4fa"
prefer = "closest-to-fallback"

[config.wallpaper]
set = false
command = "awww img --transition-type wipe --transition-duration 1.2 {{image}}"

[templates.hyprland]
input_path = '~/.config/matugen/templates/hyprland-colors.conf'
output_path = '~/.config/hypr/colors.conf'
post_hook = 'hyprctl reload 2>/dev/null || true &'

[templates.hyprland_lua]
input_path = '~/.config/matugen/templates/hyprland-colors.lua'
output_path = '~/.config/hypr/colors.lua'
post_hook = 'hyprctl reload 2>/dev/null || true &'

[templates.foot]
input_path = '~/.config/matugen/templates/foot.ini'
output_path = '~/.config/foot/foot.ini.matugen'
post_hook = 'pkill -USR1 foot 2>/dev/null || true'

[templates.dunst]
input_path = '~/.config/matugen/templates/dunstrc'
output_path = '~/.config/dunst/dunstrc'
# post_hook removed to prevent hang - dunst will be restarted via hypr reload or manually
[templates.quickshell_note]
input_path = '~/.config/matugen/templates/quickshell-note.txt'
output_path = '~/.cache/quickshell/matugen-colors.txt'

[templates.helium_theme]
input_path = '~/.config/matugen/templates/helium-theme.json'
output_path = '~/.local/share/helium-matugen-theme/manifest.json'
post_hook = 'test -p "$XDG_RUNTIME_DIR/chromugen.fifo" && echo 1 > "$XDG_RUNTIME_DIR/chromugen.fifo" 2>/dev/null || true &'
