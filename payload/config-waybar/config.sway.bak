{
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 6,
  "modules-left": ["custom/terminal", "custom/exit", "sway/workspaces", "sway/mode"],
  "modules-center": ["sway/window"],
  "modules-right": ["clock", "tray"],
  "custom/terminal": {
    "format": "  Terminal ",
    "on-click": "foot",
    "tooltip": false,
    "interval": "once"
  },
  "custom/exit": {
    "format": " ⏻ Hide ",
    "on-click": "desktop-toggle --hide",
    "tooltip-format": "Hide desktop → kmscon (tty1). Run desktop-toggle to show again.",
    "on-click-right": "sh -c 'swaymsg exit; sleep 0.3; sudo chvt 1'"
  },
  "sway/workspaces": {
    "disable-scroll": false,
    "all-outputs": true
  },
  "sway/window": {
    "max-length": 60
  },
  "clock": {
    "format": "{:%a %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "tray": {
    "spacing": 10
  }
}
