#!/bin/sh
# hypridle condition_cmd: exit 1 while a gamepad was used recently, so the
# idle step is deferred. Exit 0 lets the step run as usual.
#
# Usage: gamepad-idle-check [seconds]   (default: 60)
within=${1:-60}
state="${XDG_RUNTIME_DIR:-/tmp}/gamepad-idle-activity"

[ -f "$state" ] || exit 0
last=$(stat -c %Y "$state" 2>/dev/null) || exit 0
now=$(date +%s 2>/dev/null) || exit 0
[ $((now - last)) -lt "$within" ] && exit 1
exit 0
