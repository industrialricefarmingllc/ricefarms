#!/bin/sh
# hypr-set-wallpaper - Dolphin ServiceMenu helper for hyprpaper
# Usage: hypr-set-wallpaper <image>
set -eu
f="${1:-}"
[ -z "$f" ] && { echo "no file"; exit 1; }
p=$(realpath "$f" 2>/dev/null || echo "$f")
[ ! -f "$p" ] && { notify-send "Wallpaper error" "File not found: $p" 2>/dev/null || echo "File not found: $p"; exit 1; }
mkdir -p ~/.config/hypr
conf=~/.config/hypr/hyprpaper.conf
# backup
[ -f "$conf" ] && cp "$conf" "$conf.bak.$(date +%s)" 2>/dev/null || true
# update conf - hyprpaper 0.8.4 uses block syntax (old `wallpaper = DP-1,path` no longer loaded at startup)
cat > "$conf" <<EOF
preload = $p

wallpaper {
    monitor = DP-1
    path = $p
}

wallpaper {
    monitor =
    path = $p
}

splash = false
ipc = on
EOF
# apply live only if inside Hyprland session (HYPRLAND_INSTANCE_SIGNATURE set)
# hyprpaper 0.8.4: valid ipc is `hyprctl hyprpaper wallpaper <mon>,<path>` and `listactive` (preload/listloaded removed)
if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
  if pgrep -x hyprpaper >/dev/null 2>&1; then
    if hyprctl hyprpaper wallpaper "DP-1,$p" 2>/dev/null; then
      hyprctl hyprpaper wallpaper ",$p" 2>/dev/null || true
      notify-send "Wallpaper set" "$(basename "$p")" 2>/dev/null || true
      echo "Wallpaper set: $p"
    else
      notify-send "hyprpaper error" "wallpaper failed" 2>/dev/null || true
      echo "wallpaper failed"
      exit 1
    fi
  else
    hyprpaper >/dev/null 2>&1 &
    sleep 0.8
    if hyprctl hyprpaper wallpaper "DP-1,$p" 2>/dev/null; then
      hyprctl hyprpaper wallpaper ",$p" 2>/dev/null || true
      notify-send "Hyprpaper started" "$(basename "$p")" 2>/dev/null || true
      echo "Hyprpaper started with $p"
    else
      notify-send "Hyprpaper failed" "Check Hyprland" 2>/dev/null || true
      echo "hyprpaper start failed - is Hyprland running on VT7? check hyprctl monitors"
      exit 1
    fi
  fi
else
  # not in Hyprland (kmscon/tty1 or Plasma) - just save, will apply on next Hyprland start via hyprpaper.conf
  notify-send "Wallpaper saved" "Will apply next Hyprland start: $(basename "$p")" 2>/dev/null || true
  echo "Saved to $conf - not in Hyprland session (HYPRLAND_INSTANCE_SIGNATURE unset), will apply on next start"
fi
