# --------------------------------------------------------------------------
# small filesystem / config helpers
# --------------------------------------------------------------------------


def expand(path: str | os.PathLike) -> Path:
    return Path(os.path.expanduser(os.path.expandvars(str(path))))


def deep_merge(base: dict, extra: dict) -> dict:
    out = json.loads(json.dumps(base))
    for key, value in (extra or {}).items():
        if isinstance(value, dict) and isinstance(out.get(key), dict):
            out[key] = deep_merge(out[key], value)
        else:
            out[key] = value
    return out


def load_config(path: Path) -> dict:
    cfg = json.loads(json.dumps(DEFAULTS))
    if path.exists():
        try:
            user = json.loads(path.read_text(encoding="utf-8"))
            if isinstance(user, dict):
                cfg = deep_merge(cfg, user)
        except (OSError, json.JSONDecodeError) as exc:
            log.warning("Ignoring invalid %s: %s", path, exc)
    return cfg


def read_json(path: Path) -> dict | None:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        return value if isinstance(value, dict) else None
    except (OSError, json.JSONDecodeError):
        return None


def write_json(path: Path, value: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.replace(tmp, path)


def write_text(path: Path, value: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(value, encoding="utf-8")
    os.replace(tmp, path)


def cache_path(cfg: dict, name: str) -> Path:
    return expand(cfg["cache_dir"]) / name


def brightness_path(cfg: dict) -> Path:
    return cache_path(cfg, "brightness")


def manual_override_path(cfg: dict) -> Path:
    return cache_path(cfg, "manual-brightness.json")


def transition_path(cfg: dict) -> Path:
    return cache_path(cfg, "transition.json")


def pid_path(cfg: dict) -> Path:
    return cache_path(cfg, "pid")


def clamp_percent(value: float) -> int:
    return max(0, min(100, int(round(value))))


def read_virtual_brightness(cfg: dict) -> int:
    try:
        return clamp_percent(float(brightness_path(cfg).read_text(encoding="utf-8").strip()))
    except (OSError, ValueError):
        return 100


def read_manual_override(cfg: dict, now: float | None = None) -> dict | None:
    data = read_json(manual_override_path(cfg))
    if not data:
        return None
    try:
        expires = float(data.get("expires", 0))
        brightness = clamp_percent(float(data["brightness"]))
    except (KeyError, TypeError, ValueError):
        return None
    if expires <= (time.time() if now is None else now):
        return None
    return {"brightness": brightness, "expires": expires}


def reading_mode_on(cfg: dict) -> bool:
    try:
        return expand(cfg["reading_mode_file"]).read_text(encoding="utf-8").strip() == "on"
    except OSError:
        return False


def write_reading_mode(cfg: dict, on: bool) -> None:
    path = expand(cfg["reading_mode_file"])
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text("on\n" if on else "off\n", encoding="utf-8")
    os.replace(tmp, path)


def write_virtual_brightness(cfg: dict, percent: int, auto: bool) -> None:
    """Publish the level for Lucid's slider/OSD.

    Auto changes stamp a flag first so the OSD can tell them apart from a
    keypress or a drag, exactly like lucid-auto-brightness does.
    """
    percent = clamp_percent(percent)
    path = brightness_path(cfg)
    old = None
    try:
        old = path.read_text(encoding="utf-8").strip()
    except OSError:
        pass
    new = str(percent)
    if old == new:
        return
    if auto:
        path.parent.mkdir(parents=True, exist_ok=True)
        cache_path(cfg, "last-auto-write").write_text(str(int(time.time())), encoding="utf-8")
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(new + "\n", encoding="utf-8")
    os.replace(tmp, path)


def set_manual_brightness(cfg: dict, value: str | int | float) -> int:
    current = read_virtual_brightness(cfg)
    text = str(value).strip()
    if text.startswith(("+", "-")):
        try:
            target = current + float(text)
        except ValueError as exc:
            raise ValueError(f"not a brightness value: {value}") from exc
    else:
        try:
            target = float(text)
        except ValueError as exc:
            raise ValueError(f"not a brightness value: {value}") from exc
    target = clamp_percent(target)
    now = time.time()
    write_json(
        manual_override_path(cfg),
        {
            "brightness": target,
            "expires": now + float(cfg.get("manual_override_seconds", 90)),
        },
    )
    # The CLI is the user's hand: publish at once, without the auto-write flag.
    write_virtual_brightness(cfg, target, auto=False)
    try:
        cache_path(cfg, "last-auto-write").unlink()
    except OSError:
        pass
    signal_daemon(cfg)
    return target


def clear_manual_override(cfg: dict) -> None:
    try:
        manual_override_path(cfg).unlink()
    except OSError:
        pass
    signal_daemon(cfg)


def signal_daemon(cfg: dict) -> None:
    try:
        pid = int(pid_path(cfg).read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        return
    try:
        cmdline = Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return
    if b"lucid-ambient-eink" not in cmdline:
        return
    try:
        os.kill(pid, signal.SIGHUP)
    except OSError:
        pass


