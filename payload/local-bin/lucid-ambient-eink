    WAKE.set()


# --------------------------------------------------------------------------
# location: reuse Lucid's already-resolved geoip coordinates
# --------------------------------------------------------------------------


def read_location(cfg: dict) -> dict:
    cfg_lat = cfg.get("latitude")
    cfg_lon = cfg.get("longitude")
    if cfg_lat is not None and cfg_lon is not None:
        return {
            "lat": float(cfg_lat),
            "lon": float(cfg_lon),
            "label": "configured",
            "source": str(CONFIG_FILE),
        }

    prefs = read_json(expand(cfg["location_file"]))
    if not prefs:
        raise RuntimeError(
            f"no Lucid location in {expand(cfg['location_file'])} "
            "(and no latitude/longitude in the service config)"
        )

    try:
        lat = float(prefs["locationLat"])
        lon = float(prefs["locationLon"])
    except (KeyError, TypeError, ValueError) as exc:
        raise RuntimeError("Lucid prefs do not contain a usable location") from exc

    label = str(prefs.get("locationLabel") or prefs.get("locationName") or "").strip()
    if label == "":
        label = f"{lat:.3f}, {lon:.3f}"

    return {
        "lat": lat,
        "lon": lon,
        "label": label,
        "source": str(expand(cfg["location_file"])),
        "gps": bool(prefs.get("gpsEnabled", False)),
    }


# --------------------------------------------------------------------------
# sun position (NOAA equations; no network, no external packages)
# --------------------------------------------------------------------------


def solar_position(when: datetime, lat: float, lon: float) -> tuple[float, float]:
    """Return (elevation_deg, azimuth_deg) for an aware UTC datetime."""
    utc = when.astimezone(timezone.utc)
    day = utc.timetuple().tm_yday
    hour = utc.hour + utc.minute / 60.0 + utc.second / 3600.0
    gamma = 2.0 * math.pi / 365.0 * (day - 1 + (hour - 12.0) / 24.0)

    eqtime = 229.18 * (
        0.000075
        + 0.001868 * math.cos(gamma)
        - 0.032077 * math.sin(gamma)
        - 0.014615 * math.cos(2 * gamma)
        - 0.040849 * math.sin(2 * gamma)
    )
    decl = (
        0.006918
        - 0.399912 * math.cos(gamma)
        + 0.070257 * math.sin(gamma)
        - 0.006758 * math.cos(2 * gamma)
        + 0.000907 * math.sin(2 * gamma)
        - 0.002697 * math.cos(3 * gamma)
        + 0.00148 * math.sin(3 * gamma)
    )

    tst = hour * 60.0 + eqtime + 4.0 * lon
    ha = math.radians(((tst / 4.0 - 180.0) + 180.0) % 360.0 - 180.0)
    latr = math.radians(lat)

    cos_zen = (
        math.sin(latr) * math.sin(decl)
        + math.cos(latr) * math.cos(decl) * math.cos(ha)
    )
    cos_zen = max(-1.0, min(1.0, cos_zen))
    zenith = math.acos(cos_zen)
    elevation = 90.0 - math.degrees(zenith)

    az = math.degrees(
        math.atan2(
            math.sin(ha),
            math.cos(ha) * math.sin(latr) - math.tan(decl) * math.cos(latr),
        )
    ) + 180.0
    return elevation, az % 360.0


def max_sun_elevation_today(now: datetime, lat: float, lon: float) -> tuple[float, datetime]:
    """Scan the local day in 10-minute steps; cheap and handles polar days."""
    local = now.astimezone()
    midnight = local.replace(hour=0, minute=0, second=0, microsecond=0)
    best_el = -90.0
    best_at = midnight
    for minutes in range(0, 24 * 60 + 1, 10):
        when = midnight + timedelta(minutes=minutes)
        el, _ = solar_position(when, lat, lon)
        if el > best_el:
            best_el = el
            best_at = when
    return best_el, best_at


def clear_sky_ghi(elevation_deg: float) -> float:
    """Approximate clear-sky global horizontal irradiance in W/m²."""
    if elevation_deg <= 0.0:
        return 0.0
    s = math.sin(math.radians(elevation_deg))
    return 1050.0 * (max(0.0, s) ** 1.15)


def clear_sky_lux(elevation_deg: float, cfg: dict) -> float:
    """Haurwitz clear-sky GHI converted to photometric illuminance (lux)."""
    if elevation_deg <= 0.0:
        return 0.0
    cosz = max(0.0, math.sin(math.radians(elevation_deg)))
    if cosz <= 0.0:
        return 0.0
    ghi = 1098.0 * cosz * math.exp(-0.057 / cosz)
    return ghi * float(cfg.get("luminous_efficacy_global", 110.0))


def photometric_lux(
    elevation_deg: float,
    dni: float | None,
    dhi: float | None,
    ghi: float | None,
    cfg: dict,
) -> tuple[float, str]:
    """Convert Open-Meteo radiation to illuminance using luminous efficacy."""
    if elevation_deg <= 0.0:
        return 0.0, "night"
    cosz = max(0.0, math.sin(math.radians(elevation_deg)))
    k_dir = float(cfg.get("luminous_efficacy_direct", 105.0))
    k_diff = float(cfg.get("luminous_efficacy_diffuse", 120.0))
    k_glob = float(cfg.get("luminous_efficacy_global", 110.0))
    if dni is not None and dhi is not None:
        try:
            direct = max(0.0, float(dni)) * cosz
            diffuse = max(0.0, float(dhi))
            return direct * k_dir + diffuse * k_diff, "dni+dhi"
        except (TypeError, ValueError):
            pass
    if ghi is not None:
        try:
            return max(0.0, float(ghi)) * k_glob, "ghi"
        except (TypeError, ValueError):
            pass
    return clear_sky_ghi(elevation_deg) * k_glob * 0.75, "fallback"


# --------------------------------------------------------------------------
# weather: Open-Meteo current radiation already includes cloud attenuation
# --------------------------------------------------------------------------


def weather_request(cfg: dict, lat: float, lon: float) -> str:
    query = urllib.parse.urlencode(
        {
            "latitude": f"{lat:.6f}",
            "longitude": f"{lon:.6f}",
            "current": ",".join(
                [
                    "temperature_2m",
                    "is_day",
                    "weather_code",
                    "cloud_cover",
                    "shortwave_radiation",
                    "direct_normal_irradiance",
                    "diffuse_radiation",
                ]
            ),
            "hourly": "shortwave_radiation",
            "daily": "sunrise,sunset,daylight_duration",
            "timezone": "auto",
            "forecast_days": 2,
        }
    )
    return f"{cfg['weather_url']}?{query}"


def fetch_weather(cfg: dict, lat: float, lon: float) -> dict:
    # Lucid already uses curl for its weather/geoip calls. Use the same path:
    # it keeps proxy/TLS behaviour identical and avoids Python's differing
    # socket stack on this host.
    timeout = float(cfg["weather_timeout_seconds"])
    command = [
        str(cfg.get("curl", "curl")),
        "-sf",
        "--max-time",
        str(int(timeout)),
        weather_request(cfg, lat, lon),
    ]
    try:
        result = subprocess.run(
            command,
            capture_output=True,
            text=True,
            timeout=timeout + 5.0,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise ValueError(f"curl could not run: {exc}") from exc
    if result.returncode != 0:
        raise ValueError(
            f"curl exited {result.returncode}: {result.stderr.strip() or 'no output'}"
        )
    data = json.loads(result.stdout)
    if not isinstance(data, dict) or "current" not in data:
        raise ValueError("weather service returned no current block")
    return data


def weather_cache_path(cfg: dict) -> Path:
    return expand(cfg["cache_dir"]) / "weather.json"


def location_key(loc: dict) -> str:
    return f"{loc['lat']:.5f},{loc['lon']:.5f}"


def get_weather(cfg: dict, loc: dict) -> tuple[dict | None, float | None, str]:
    """Return (data, age_seconds, source); never let a network blip wipe the day."""
    now = time.time()
    key = location_key(loc)
    cached = read_json(weather_cache_path(cfg))
    if cached and cached.get("key") == key:
        age = max(0.0, now - float(cached.get("fetched_at", 0)))
        if age <= float(cfg["weather_refresh_seconds"]):
            return cached.get("data"), age, "cache"
    else:
        cached = None
        age = None

    try:
        data = fetch_weather(cfg, loc["lat"], loc["lon"])
        write_json(
            weather_cache_path(cfg),
            {"key": key, "fetched_at": now, "data": data},
        )
        return data, 0.0, "network"
    except (OSError, ValueError) as exc:
        log.warning("Weather fetch failed: %s", exc)
        if cached and cached.get("data"):
            return cached.get("data"), age, "stale-cache"
        return None, None, "unavailable"


# --------------------------------------------------------------------------
# light -> effect
# --------------------------------------------------------------------------


def reference_radiation(
    cfg: dict,
    data: dict | None,
    now: datetime,
    max_elevation: float,
) -> tuple[float, str]:
    mode = str(cfg.get("reference", "clear_sky_noon")).lower()
    if mode == "absolute":
        return max(1.0, float(cfg["absolute_max_radiation"])), mode

    if mode == "day_peak" and data:
        hourly = data.get("hourly") or {}
        times = hourly.get("time") or []
        values = hourly.get("shortwave_radiation") or []
        today = now.astimezone().date().isoformat()
        peak = 0.0
        for stamp, value in zip(times, values):
            if str(stamp).startswith(today) and value is not None:
                try:
                    peak = max(peak, float(value))
                except (TypeError, ValueError):
                    pass
        if peak > 1.0:
            return peak, "day_peak"

    return max(1.0, clear_sky_ghi(max_elevation)), "clear_sky_noon"


def base_effect(fraction: float, start: float, easing: str) -> float:
    start = max(1e-6, float(start))
    if fraction >= start:
        return 0.0
    x = max(0.0, min(1.0, (start - fraction) / start))
    if str(easing).lower() == "smoothstep":
        x = x * x * (3.0 - 2.0 * x)
    return x


def quantize_effect(effect: float, step: float) -> float:
    step = max(0.001, min(1.0, float(step)))
    level = round(effect / step) * step
    if level < step * 0.5:
        return 0.0
    return max(0.0, min(1.0, level))


def inactive_extra_dim(cfg: dict, level: float) -> tuple[float, float]:
    """Return (total inactive black dim, extra overlay alpha).

    The screen shader is global, so it carries the focused-screen cap. The
    extra is normally drawn as a click-through black layer in Quickshell; the
    caller zeroes it when the shader fallback carries the dimming instead.
    """
    active = max(0.0, min(1.0, float(cfg["max_black_overlay"]) * level))
    inactive = max(
        0.0, min(1.0, float(cfg.get("max_black_overlay_inactive", 0.5)) * level)
    )
    if inactive <= active or active >= 1.0:
        return inactive, 0.0
    # The shader now dims in linear light. The click-through overlay is an
    # sRGB black rectangle, so convert the remaining linear light factor back
    # to the sRGB alpha that produces it.
    wanted = (1.0 - inactive) / (1.0 - active)
    extra = 1.0 - wanted ** (1.0 / 2.2)
    return inactive, max(0.0, min(1.0, extra))


