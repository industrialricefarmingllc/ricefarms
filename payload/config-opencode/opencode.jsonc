{
  "$schema": "https://opencode.ai/config.json",
  "lsp": false,
  "agent": {
    "plan": {
      "model": "opencode/muse-spark-1.3-contributor-free",
      "variant": "high"
    },
    "build": {
      "model": "opencode/muse-spark-1.3-contributor-free",
      "variant": "high"
    }
  },
  "permission": {
    "*": "allow",
    "websearch": "allow",
    "chrome-devtools_take_screenshot": "deny",
    "*screenshot*": "deny",
    "bash": {
      "*": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git push *": "allow",
      "*grim*": "deny",
      "*slurp*": "deny",
      "*hyprshot*": "deny",
      "*screenshot*": "deny",
      "*x11grab*": "deny",
      "*kmsgrab*": "deny",
      "*ImageGrab*": "deny",
      "*grep*": "deny",
      "*ripgrep*": "allow"
    },
    "read": {
      "*": "allow",
      "*.png": "deny",
      "*.jpg": "deny",
      "*.jpeg": "deny",
      "*.webp": "deny",
      "*.gif": "deny"
    }
  },
  "permissions": [
    { "action": "read", "resource": "*.png", "effect": "deny" },
    { "action": "read", "resource": "*.PNG", "effect": "deny" },
    { "action": "read", "resource": "*.jpg", "effect": "deny" },
    { "action": "read", "resource": "*.JPG", "effect": "deny" },
    { "action": "read", "resource": "*.jpeg", "effect": "deny" },
    { "action": "read", "resource": "*.webp", "effect": "deny" },
    { "action": "read", "resource": "*.gif", "effect": "deny" },
    { "action": "read", "resource": "*.bmp", "effect": "deny" },
    { "action": "read", "resource": "*.tiff", "effect": "deny" },
    { "action": "read", "resource": "*.avif", "effect": "deny" },
    { "action": "read", "resource": "*.ico", "effect": "deny" },
    { "action": "read", "resource": "*.pdf", "effect": "deny" }
  ],
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "bun",
        "x",
        "chrome-devtools-mcp@latest",
        "--browser-url=http://127.0.0.1:9222",
        "--isolated"
      ]
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    }
  },
  "plugin": [
    "/home/nicerice/.config/opencode/plugins/openhooks/plugin.mjs"
  ]
}
