#version 320 es
// Generated by matugen from /home/nicerice/Pictures/wallpapers/matugen/wallhaven-gwmyk7.jpg - do not edit
// Dark Homogenizer — unifies near-neutral dark flats (terminal bg etc.) toward the theme
// surface color; saturated images and brights pass through untouched. No tonemap core,
// single texture fetch, no neighbor sampling (safe for Hyprland damage tracking).
// Palette: source=#02a4ef primary=#97ccf8 secondary=#b8c8d9 tertiary=#d0c0e8 surface=#101417
// Edit tuning constants below in the *template* (~/.config/matugen/templates/hypr-shader-agx.glsl) — not the output file — so changes persist across wallpapers.
// (Filenames keep the historic agx name so matugen config + shader.lua references keep working.)

precision highp float;
in vec2 v_texcoord;
uniform sampler2D tex;
out vec4 fragColor;

// --- Matugen colors (auto-updated on wallpaper change) ---
const vec3 HOMO_SURFACE = vec3(16.0 / 255.0, 20.0 / 255.0, 23.0 / 255.0);
const vec3 HOMO_PRIMARY = vec3(151.0 / 255.0, 204.0 / 255.0, 248.0 / 255.0);
const vec3 HOMO_SECONDARY = vec3(184.0 / 255.0, 200.0 / 255.0, 217.0 / 255.0);
const vec3 HOMO_TERTIARY = vec3(208.0 / 255.0, 192.0 / 255.0, 232.0 / 255.0);

// --- Tuning ---
const float HOMO_STRENGTH  = 0.60; // 0-1 overall effect inside the gated band
const float HOMO_LUMA_FULL = 0.10; // full effect below this luma (lowered as requested, was 0.16)
const float HOMO_LUMA_FADE = 0.20; // zero effect above this luma (lowered as requested, was 0.33)
const float HOMO_BLACK_TOE = 0.12; // darkest blacks keep original, smooth 0-toe ramp (4x as requested)
const float HOMO_SAT_FULL  = 0.08; // full effect below this saturation
const float HOMO_SAT_FADE  = 0.20; // zero effect above (images stay original)
const float HOMO_DESAT     = 0.50; // chroma-noise removal before inking (0-1)
const float HOMO_INK_MIX   = 0.70; // clean -> uniform ink blend (0-1)
const float INK_HUE        = 0.75; // mix surface->basis for the uniform ink (higher = more wallpaper saturation)
const float INK_SAT        = 3.00;  // saturation boost for the ink (way up as requested)
const float INK_LUMA_KEEP  = 0.75; // 1 = luma-matched darks (grey ink), lower = brighter + more saturated

void main() {
    vec4 pixColor = texture(tex, v_texcoord);
    vec3 col = pixColor.rgb;
    float luma = dot(col, vec3(0.2126, 0.7152, 0.0722));
    float sat = max(col.r, max(col.g, col.b)) - min(col.r, min(col.g, col.b));
    // cheap early-out: brights and colorful pixels are never touched
    if (luma > HOMO_LUMA_FADE || sat > HOMO_SAT_FADE) {
        fragColor = pixColor;
        return;
    }
    // smooth gates: dark-only x neutral-only
    float lumaMask = 1.0 - smoothstep(HOMO_LUMA_FULL, HOMO_LUMA_FADE, luma);
    float satMask = 1.0 - smoothstep(HOMO_SAT_FULL, HOMO_SAT_FADE, sat);
    float toeMask = smoothstep(0.0, HOMO_BLACK_TOE, luma); // pure blacks stay original
    float mask = lumaMask * satMask * toeMask * HOMO_STRENGTH;
    // uniform ink from theme, luma-matched so shading/detail survives
    // basis = most saturated palette color so the wallpaper hue survives in the darks
    // (uniform branch over consts — no per-pixel divergence, no flicker risk)
    float satP = max(HOMO_PRIMARY.r, max(HOMO_PRIMARY.g, HOMO_PRIMARY.b)) - min(HOMO_PRIMARY.r, min(HOMO_PRIMARY.g, HOMO_PRIMARY.b));
    float satS = max(HOMO_SECONDARY.r, max(HOMO_SECONDARY.g, HOMO_SECONDARY.b)) - min(HOMO_SECONDARY.r, min(HOMO_SECONDARY.g, HOMO_SECONDARY.b));
    float satT = max(HOMO_TERTIARY.r, max(HOMO_TERTIARY.g, HOMO_TERTIARY.b)) - min(HOMO_TERTIARY.r, min(HOMO_TERTIARY.g, HOMO_TERTIARY.b));
    vec3 basis = HOMO_PRIMARY;
    if (satS > satP && satS > satT) basis = HOMO_SECONDARY;
    else if (satT > satP && satT > satS) basis = HOMO_TERTIARY;
    vec3 inkBase = mix(HOMO_SURFACE, basis, INK_HUE);
    float inkLuma = dot(inkBase, vec3(0.2126, 0.7152, 0.0722));
    inkBase = mix(vec3(inkLuma), inkBase, INK_SAT);
    // partial luma match: 1.0 keeps darks dark but greys the ink out, lower lifts + saturates
    float keep = mix(1.0, luma / max(inkLuma, 1e-3), INK_LUMA_KEEP);
    vec3 inkMapped = inkBase * keep;
    inkMapped = clamp(inkMapped, 0.0, 1.0);
    // kill chroma noise, then pull toward the uniform ink
    vec3 clean = mix(col, vec3(luma), HOMO_DESAT);
    vec3 homo = mix(clean, inkMapped, HOMO_INK_MIX);
    fragColor = vec4(clamp(mix(col, homo, mask), 0.0, 1.0), pixColor.a);
}
