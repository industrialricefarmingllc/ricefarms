pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io
import "root:/config"

// The wallpaper folder, the caches pibble generates beside it, and the
// client-side "xray" blur that stands in for compositor blur.
//
// Both halves live here together because they are produced by one scan: the
// blurred variant the launcher draws behind itself and the $BLUR a wallpaper
// command receives are the same file, generated by the same background pass
// that generates thumbnails.
Singleton {
    id: root

    // Injected by LauncherWindow, which is the only thing that knows which
    // output the launcher actually mapped onto. Until it exists (and if it
    // never does) the primary output stands in, so the very first scan is
    // still keyed on real geometry.
    property var screen: Quickshell.screens.length > 0 ? Quickshell.screens[0] : null
    // Also injected by LauncherWindow: a wallpaper applied while the launcher
    // is up must not swap the backdrop out from under it (see syncXrayShown).
    property bool launcherShown: false

    readonly property string dir: SystemInfo.expandHome(Settings.wallpaperDir)

    // Each entry: path|thumb|blurred|pan. All three generated variants point
    // into cacheRoot, keyed by a hash of the source path (stable across
    // renames of unrelated files, safe across multiple wallpaperDirs);
    // <stem>blurred.<ext> next to the source is still honored as a
    // user-supplied override of the blurred one.
    //
    // The cache is split by the *shape* of what it holds, not by which pane
    // reads it - one file often serves two - so a variant's directory says
    // what it is:
    //
    //   thumbnails/crops   480x270 center crop, images and gifs
    //   thumbnails/wide    uncropped, source aspect, <=1920x1080
    //   thumbnails/clips   the clipboard's own thumbs (Clipboard owns these)
    //   blurred            output-sized and pre-blurred, see the xray block
    //
    // thumb is what a grid tile draws and pan is what the carousel slides a
    // fixed window across, so an image's thumb is its crop and its pan is its
    // wide still. A video has no crop at all - Image can't decode the source
    // file - so its wide still is both, one file under one name.
    //
    // One blurred image serves both uses: the launcher's own backdrop in
    // "xray" mode and the $BLUR the wallpaper command gets (see
    // applyWallpaper) - they're the same picture, so they're the same file.
    property var list: []
    // raw stdout of the scan `list` was last built from; see where it's compared
    property string lastScanText: ""
    // xrayCacheKey as of the last scan that landed. Only when it matches the
    // current one do the entries say anything about the backdrops the
    // launcher is actually after - before that (a scan from before the
    // output scale resolved, say) a missing entry means "not looked for
    // yet", not "not there".
    property string scanKey: ""
    property string lastMissingDir: ""
    // matugen chokes on/slow-decodes an animated source (and can't read
    // video at all); sample the cached static thumbnail instead when the
    // current wallpaper is a .gif, .mp4, or Wallpaper Engine wall (whose path
    // is a directory). Falls back to
    // the raw path before the background scan has generated a thumbnail for
    // it yet.
    // System wallpaper truth (written by whatever sets the wallpaper -
    // usually Lucid): pibble's own record goes stale when the wallpaper
    // is picked outside the pibble picker, which once themed the whole
    // shell around the wrong image. Prefer it; fall back to our record.
    property string sysWallpaper: ""
    FileView {
        path: Quickshell.env("HOME") + "/.cache/current_wallpaper"
        watchChanges: true
        onFileChanged: reload()
        onLoaded: root.sysWallpaper = text().trim()
    }
    readonly property string matugenSource: {
        if (root.sysWallpaper)
            return root.sysWallpaper;
        const w = root.list.find(x => x.path === Settings.currentWallpaper);
        return (w && (w.gif || w.video || w.we) && w.thumb) ? w.thumb : Settings.currentWallpaper;
    }
    // What actually plays for a live preview: a Wallpaper Engine wall's
    // anim file (its video, or an animated preview gif), otherwise the
    // wall's own path. Every preview player - grid/carousel gif tiles and
    // the shared mp4 surfaces - sources through this, so a WE wall animates
    // from its preview while everything else behaves exactly as before.
    function mediaOf(w): string {
        return (!w) ? "" : ((w.we && w.anim) ? w.anim : w.path);
    }
    // The cheap looping clip the picker tiles play: the baked lightweight
    // transcode (see the generation pass), which replays instantly instead
    // of decoding the full-size source on every open. Regular gifs play
    // their source file directly (local and already small enough); videos
    // keep the shared player. A Workshop gif preview plays raw until its
    // bake lands, so tiles animate from the first scan instead of sitting
    // still through the transcode queue.
    function previewAnimOf(w): string {
        if (!w)
            return "";
        if (w.animPrev)
            return w.animPrev;
        if (w.video)
            return "";
        if (w.we)
            return (w.gif && w.anim) ? w.anim : "";
        return w.gif ? w.path : "";
    }
    // Started a tick late: this is called from change handlers on the very
    // properties the scan's own command binding reads (see xrayCacheKey), and
    // a binding is only guaranteed to have caught up by the time the next one
    // reads it - flipping `running` inline reliably ran the scan against the
    // previous geometry.
    // Never restarts a scan in flight (killing it mid-run yields empty
    // output, and retriggers land faster than big-folder runs finish, so
    // restarts pile up instead of converging), and floored to one start
    // per 15s once results exist (rescan fires on every open and every
    // 3s while generating).
    property double _lastScanStart: 0
    function rescan(): void {
        if (scan.running)
            return;
        const now = Date.now();
        if (root.list.length > 0 && now - root._lastScanStart < 15000)
            return;
        root._lastScanStart = now;
        scan.running = false;
        Qt.callLater(() => scan.running = true);
    }
    // Settings toggles (weEnabled, previewGeneration) need the next scan to
    // happen now, not at the 15s floor above: dropping WE entries or stopping
    // generation is the point of the toggle, and waiting out the floor would
    // leave stale entries / running work behind.
    function rescanForced(): void {
        root._lastScanStart = 0;
        root.rescan();
    }
    // cache entries the last scan found missing, and the one re-scan armed
    // to pick them up once the background generation has written them (see
    // where it's armed, in scan's output handler)
    property string generationMissing: ""
    // scan text the sweep-only pass (previewGeneration off) last ran
    // against - orphans only appear when the entry set changes, so an
    // unchanged scan has nothing to sweep and skips the background pass
    // entirely instead of redoing its md5 loop on every open.
    property string lastSweptText: ""
    Timer {
        id: generationRetry
        interval: 3000
        onTriggered: root.rescan()
    }
    // Coalesced thumbnail upgrades (see the output handler): a pending
    // reassign that only flips thumbs, applied at most every 30s so
    // background generation doesn't blank tiles mid-browse.
    property string pendingUpgradeText: ""
    property var pendingUpgradeWalls: []
    Timer {
        id: upgradeCoalesce
        interval: 30000
        onTriggered: {
            if (root.pendingUpgradeText !== "" && root.pendingUpgradeText !== root.lastScanText) {
                root.lastScanText = root.pendingUpgradeText;
                root.list = root.pendingUpgradeWalls;
            }
            root.pendingUpgradeText = "";
            root.pendingUpgradeWalls = [];
        }
    }
    Process {
        id: scan
        running: true
        // the xray parameters this run went looking for, captured at spawn
        // rather than read back when it finishes - the two can differ by a
        // whole scan (the output scale resolving is exactly that case), and
        // reading it late would claim a stale result was current
        property string scanKey: ""
        onRunningChanged: if (running) scanKey = root.xrayCacheKey
        command: ["bash", "-c", `
            cd "$1" || { echo NODIR; exit 0; }
            cachedir="$2"
            shopt -s nullglob nocaseglob globstar
            # Wallpaper Engine workshop enumeration (see the second loop
            # below): ONE python for the whole workshop dir, emitting
            # tab-separated wall fields including the md5 cache keys, so a
            # 60-wall workshop costs one interpreter instead of 60+ plus
            # 180 md5sum spawns.
            we_scan_workshop() {
                python3 -c '
import hashlib,json,os,sys
root,geom,sigma=sys.argv[1],sys.argv[2],sys.argv[3]
def md5(s): return hashlib.md5(s.encode()).hexdigest()
try: names=sorted(os.listdir(root))
except Exception: names=[]
for name in names:
    d=os.path.join(root,name)
    if not os.path.isdir(d): continue
    if not os.path.isfile(os.path.join(d,"project.json")): continue
    try: p=json.load(open(os.path.join(d,"project.json")))
    except Exception: continue
    prev=p.get("preview") or ""
    if prev and not os.path.isabs(prev): prev=os.path.join(d,prev)
    if not prev or not os.path.isfile(prev):
        prev=""
        for cand in ("preview.jpg","preview.jpeg","preview.png","preview.gif","preview.mp4"):
            c=os.path.join(d,cand)
            if os.path.isfile(c): prev=c; break
    if not prev: continue
    title=((p.get("title") or name).replace(chr(10)," ").replace(chr(9)," ").replace("|"," "))
    typ=(p.get("type") or "").lower()
    mf=p.get("file") or ""
    if mf and not os.path.isabs(mf): mf=os.path.join(d,mf)
    if not mf or not os.path.isfile(mf): mf=""
    # no empty columns: read splits on TAB, which is IFS whitespace, so
    # runs of tabs collapse and every later column shifts left (scenes
    # have no loose media file, which broke all of their cache keys).
    # "-" stands in for empty and is mapped back below.
    if not typ: typ="-"
    if not mf: mf="-"
    print("%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s" % (d,prev,title,typ,mf,md5(d+"|t5"),md5(d+"|p2"),md5(d+"|"+geom+"|"+sigma+"|r5"),md5(d+"|a7")))
' "$1" "$2" "$3" 2>/dev/null
            }
            # recursive: theme-organized libraries keep images in
            # subfolders (e.g. <dir>/matugen/x.jpg); ** matches those
            # as well as top-level files. Fresh sources stand in as
            # their own tiles until crops land, so a big folder is
            # browsable immediately while generation catches up.
            { for f in **/*.png **/*.jpg **/*.jpeg **/*.webp **/*.gif **/*.mp4; do
                case "$f" in *blurred.*) continue ;; esac
                stem="\${f%.*}" ext="\${f##*.}"
                isvid=0; case "\${ext,,}" in mp4) isvid=1 ;; esac
                # every generated still is png: rescaled, never recompressed,
                # so gradients survive without banding (jpeg quantization
                # would show on wallpapers even at high quality settings)
                oext="png"
                # versioned like bkey below (r<n>): bump t<n> (here and in
                # the generation pass) whenever the magick crop recipe
                # changes, so stale entries fall out of the sweep instead of
                # sticking around under the old recipe until their source file
                # happens to change. t5 = 720x405 png crops (crisp on HiDPI
                # tiles, lossless).
                key=$(printf '%s' "$PWD/$f|t5" | md5sum | cut -d' ' -f1)
                # the wide still, versioned the same way (p<n>) and for the
                # same reason as the two keys around it (p2 = png wide)
                pkey=$(printf '%s' "$PWD/$f|p2" | md5sum | cut -d' ' -f1)
                # the blurred variant is the one cache entry that depends on
                # more than the source file, so the output geometry, the blur
                # and the recipe version go in its key too: a resized output,
                # a retuned kernel or a changed recipe then lands on a
                # different name, and the old one falls out of the sweep
                # below like any other dead entry. Bump r<n> (here and in the
                # generation pass) whenever the magick command changes.
                bkey=$(printf '%s' "$PWD/$f|$3|$4|r5" | md5sum | cut -d' ' -f1)
                # the wide still is always png (see the generation pass),
                # whatever the source was
                wide="$cachedir/thumbnails/wide/$pkey.png"
                thumb="" blur="" pan=""
                # only trust caches newer than the source image
                [ "$wide" -nt "$f" ] && pan="$wide"
                if [ "$isvid" = "1" ]; then
                    # a video has no crop of its own: Image can't decode the
                    # source file at all, so the wide still is what the grid
                    # tile draws as well as what the carousel pans across.
                    # Both stay empty until the generation pass takes it.
                    thumb="$pan"
                else
                    # a fresh image/gif stands in as its own tile (the Image
                    # element decodes it directly, just slowly) until the crop
                    # lands
                    thumb="$PWD/$f"
                    [ "$cachedir/thumbnails/crops/$key.$oext" -nt "$f" ] && thumb="$cachedir/thumbnails/crops/$key.$oext"
                fi
                [ "$cachedir/blurred/$bkey.png" -nt "$f" ] && blur="$cachedir/blurred/$bkey.png"
                [ -e "\${stem}blurred.$ext" ] && blur="$PWD/\${stem}blurred.$ext"
                printf '%s|%s|%s|%s\n' "$PWD/$f" "$thumb" "$blur" "$pan"
            done
            # Wallpaper Engine workshop entries: one batched python lists
            # every wall dir with preview, title, type, media and the
            # versioned cache keys (same t5/p2/r5 scheme as the file pass).
            # Without python3, a reduced loop below covers preview.* walls
            # with basename titles (no video anims).
            wedir="$5"
            if [ -n "$wedir" ] && [ -d "$wedir" ]; then
                if command -v python3 >/dev/null 2>&1; then
                    we_scan_workshop "$wedir" "$3" "$4" 2>/dev/null | while IFS='	' read -r w psrc title wtype wmedia key pkey bkey akey; do
                        [ -n "$w" ] && [ -f "$psrc" ] || continue
                        # "-" placeholders for empty columns, see above
                        [ "$wtype" = "-" ] && wtype=""
                        [ "$wmedia" = "-" ] && wmedia=""
                    # playable preview for the picker's live tiles: a video
                    # wall's own file, else the baked clip (see below) -
                    # scenes render via the renderer on apply; the picker
                    # only ever plays clips.
                    anim=""
                    [ "$wtype" = "video" ] && [ -n "$wmedia" ] && anim="$wmedia"
                    [ -z "$anim" ] && case "$psrc" in *.gif|*.GIF) anim="$psrc" ;; esac
                    pext="\${psrc##*.}"
                    oext="png"
                    wide="$cachedir/thumbnails/wide/$pkey.png"
                    thumb="$psrc" blur="" pan=""
                    [ "$wide" -nt "$psrc" ] && pan="$wide"
                    [ "$cachedir/thumbnails/crops/$key.$oext" -nt "$psrc" ] && thumb="$cachedir/thumbnails/crops/$key.$oext"
                    [ "$cachedir/blurred/$bkey.png" -nt "$psrc" ] && blur="$cachedir/blurred/$bkey.png"
                    weVideo=0; [ "$wtype" = "video" ] && weVideo=1
                    # baked lightweight animated preview (see the generation
                    # pass): instant replay instead of decoding the full-size
                    # source every open. Compared against the animation's own
                    # source (full video for video walls, preview otherwise).
                    asrc="$psrc"; [ "$weVideo" = "1" ] && [ -n "$wmedia" ] && asrc="$wmedia"
                    animPrev=""
                    [ "$cachedir/animated/$akey.mp4" -nt "$asrc" ] && animPrev="$cachedir/animated/$akey.mp4"
                    printf '%s|%s|%s|%s|1|%s|%s|%s|%s\n' "$w" "$thumb" "$blur" "$pan" "$title" "$anim" "$weVideo" "$animPrev"
                done
                else
                    # no python3: preview files only, basename titles, keys
                    # via md5sum as in the file pass (rare path)
                    for w in "$wedir"/*/; do
                        [ -d "$w" ] || continue
                        w="\${w%/}"
                        psrc=""
                        for cand in "$w"/preview.jpg "$w"/preview.jpeg "$w"/preview.png "$w"/preview.gif "$w"/preview.mp4; do
                            [ -f "$cand" ] && psrc="$cand" && break
                        done
                        [ -n "$psrc" ] || continue
                        title=$(basename "$w")
                        anim=""; case "$psrc" in *.gif|*.GIF) anim="$psrc" ;; esac
                        pext="\${psrc##*.}"
                        oext="png"
                        key=$(printf '%s' "$w|t5" | md5sum | cut -d' ' -f1)
                        pkey=$(printf '%s' "$w|p2" | md5sum | cut -d' ' -f1)
                        bkey=$(printf '%s' "$w|$3|$4|r5" | md5sum | cut -d' ' -f1)
                        akey=$(printf '%s' "$w|a7" | md5sum | cut -d' ' -f1)
                        wide="$cachedir/thumbnails/wide/$pkey.png"
                    thumb="$psrc" blur="" pan=""
                    [ "$wide" -nt "$psrc" ] && pan="$wide"
                    [ "$cachedir/thumbnails/crops/$key.$oext" -nt "$psrc" ] && thumb="$cachedir/thumbnails/crops/$key.$oext"
                    [ "$cachedir/blurred/$bkey.png" -nt "$psrc" ] && blur="$cachedir/blurred/$bkey.png"
                    animPrev=""
                    [ "$cachedir/animated/$akey.mp4" -nt "$psrc" ] && animPrev="$cachedir/animated/$akey.mp4"
                    printf '%s|%s|%s|%s|1|%s|%s|0|%s\n' "$w" "$thumb" "$blur" "$pan" "$title" "$anim" "$animPrev"
                    done
                fi
            fi
            } | sort`, "_", root.dir, SystemInfo.cacheRoot,
            root.xraySize.width + "x" + root.xraySize.height, String(root.xrayCacheSigma),
            // weEnabled off blanks the workshop dir: the bash below treats an
            // empty dir as "no Workshop entries". The folder itself is kept in
            // Settings, so re-enabling restores the setup as it was.
            (Settings.weEnabled ? SystemInfo.expandHome(Settings.weWorkshopDir) : "")]
        stdout: StdioCollector {
            onStreamFinished: {
                root.scanKey = scan.scanKey;
                if (text.trim() === "NODIR") {
                    root.lastScanText = text;
                    root.list = [];
                    root.pendingUpgradeText = "";
                    root.pendingUpgradeWalls = [];
                    if (root.lastMissingDir !== root.dir) {
                        root.lastMissingDir = root.dir;
                        Notifier.error("Wallpaper folder not found", root.dir + "\n\nChange it in Settings > Pages > Wallpapers path.");
                    }
                    return;
                }
                root.lastMissingDir = "";
                const walls = text.trim().split("\n").filter(l => l).map(l => {
                    const p = l.split("|");
                    const anim = p[6] || "";
                    return { path: p[0], thumb: p[1], blur: p[2] || "", pan: p[3] || "", gif: /\.gif$/i.test(p[0]) || /\.gif$/i.test(anim), video: /\.mp4$/i.test(p[0]) || /\.mp4$/i.test(anim), we: p[4] === "1", title: (p[5] || "").trim(), anim: anim, weVideo: p[7] === "1", animPrev: p[8] || "" };
                });
                // One list regardless of source: Workshop entries carry
                // titles, files carry paths, so sort by the display name
                // (what wallpaperName() shows) instead of the scan's
                // path order, which clumps whole directories together.
                const dispName = w => (w.title || w.path.split("/").pop()).toLowerCase();
                walls.sort((a, b) => {
                    const an = dispName(a), bn = dispName(b);
                    return an < bn ? -1 : an > bn ? 1 : 0;
                });
                // Reassigning this array invalidates every tile's model entry,
                // which tears each delegate down and rebuilds it - re-creating
                // its ClippingRectangle render target and re-uploading its
                // thumbnail texture. A scan runs on every launcher open, and
                // the folder is almost never different between two of them, so
                // that cost was being paid mid-reveal for an identical result.
                // The scan's raw output is the canonical form of everything
                // `walls` is derived from, so an unchanged one means an
                // unchanged model: keep the existing array and its delegates.
                if (text !== root.lastScanText) {
                    // Same paths, new thumbs (background generation landing
                    // crops): coalesce instead of reassigning, or tiles
                    // blank and selection churns every few seconds.
                    // Added/removed files apply at once.
                    const newPaths = walls.map(w => w.path);
                    const curPaths = root.list.map(w => w.path);
                    const samePaths = root.list.length > 0 && newPaths.length === curPaths.length && newPaths.every((p, i) => p === curPaths[i]);
                    if (samePaths) {
                        root.pendingUpgradeText = text;
                        root.pendingUpgradeWalls = walls;
                        upgradeCoalesce.restart();
                    } else {
                        root.lastScanText = text;
                        root.list = walls;
                        root.pendingUpgradeText = "";
                        root.pendingUpgradeWalls = [];
                    }
                }
                // Generate missing thumbnails (a full 5K image standing in as
                // its own thumbnail costs ~100ms to decode+upload), pan
                // sources and blurred
                // variants in the background; the next scan picks them up and
                // applying never has to blur synchronously. Also sweeps cache
                // entries whose source wallpaper is gone - runs every scan
                // (not just when something's missing) so deletions get cleaned
                // up promptly.
                //
                // Both consumers of the blurred variant gate it the same way:
                // it's wanted if the launcher draws it (xray mode) or the
                // wallpaper command asks for it ($BLUR). The geometry check is
                // what holds it back until the output scale it's keyed on has
                // resolved.
                const wantBlur = (Settings.bgBlur === "xray" || Settings.wallCommand.includes("$BLUR"))
                    && root.xraySize.width > 0 && root.xrayCacheSigma > 0;
                // current wallpaper first: on a cold cache its backdrop is the
                // one thing the launcher needs before any other entry, and a
                // big folder is minutes of work to get through
                const paths = walls.map(w => w.path);
                const cur = paths.indexOf(Settings.currentWallpaper);
                const order = cur > 0 ? [paths[cur]].concat(paths.slice(0, cur), paths.slice(cur + 1)) : paths;
                // Only the variants the picker actually shows count as
                // missing. The grid draws crops (thumb), the carousels pan
                // across wides - baking both for every wall doubles the
                // background work on first open for a variant nobody looks
                // at. Videos are the exception: their wide still *is* the
                // grid thumb too (Image can't decode the source), so they
                // need it in both styles. Blurred counts only where it is
                // ever read: xray shows the current wallpaper alone, so only
                // that one needs a bake - $BLUR can be any pick, so it keeps
                // the old all-walls behavior (see blurAll below).
                const isGrid = Settings.wallpaperStyle === "grid";
                const blurAll = Settings.wallCommand.includes("$BLUR");
                const thumbMissing = w => {
                    if (w.video)
                        return w.pan === "";
                    if (w.we)
                        return isGrid ? String(w.thumb).indexOf("/thumbnails/crops/") < 0 : w.pan === "";
                    if (isGrid)
                        return w.thumb === w.path;
                    return w.pan === "";
                };
                const missing = walls.filter(w => thumbMissing(w) || (wantBlur && (blurAll || w.path === Settings.currentWallpaper) && w.blur === "")).map(w => w.path).join("|");
                // previewGeneration off stops the magick/ffmpeg bakes and the
                // renderer-capture trigger below, so there is nothing to
                // re-arm for either: the missing set can't shrink while
                // nothing generates. Cleared rather than recorded so
                // re-enabling re-arms from a clean state. The cache sweep
                // still runs (see genon in the pass below) so stale entries
                // from a previous folder don't pile up as duplicates.
                if (!Settings.previewGeneration) {
                    root.generationMissing = "";
                    // Sweep-only mode: nothing here can shrink `missing`,
                    // and orphans only appear when the entry set changes.
                    // Skip the background pass (and its per-file md5 loop)
                    // on unchanged scans.
                    if (text === root.lastSweptText)
                        return;
                    root.lastSweptText = text;
                } else {
                    if (missing !== "" && missing !== root.generationMissing)
                        generationRetry.restart();
                    root.generationMissing = missing;
                }
                Quickshell.execDetached(["nice", "-n", "10", "bash", "-c", `
                    walldir="$1" cachedir="$2" gb="$3" alerts="$4" xgeom="$5" xsigma="$6" weon="$7" isgrid="$8" curwall="$9" blurall="\${10}" genon="\${11}"; shift 11
                    # Throttled background work: single-threaded magick so a
                    # thumbnail storm can't saturate the machine on every open.
                    export MAGICK_THREAD_LIMIT=1
                    mkdir -p "$cachedir/thumbnails/crops" "$cachedir/thumbnails/wide" "$cachedir/blurred" "$cachedir/animated" "$cachedir/captures"
                    capdir="$cachedir/captures"
                    # Layouts this cache has had before: wallpapers/ + xray/
                    # (from when the backdrop had a cache of its own, before
                    # thumbnails/ and blurred/ moved up next to the
                    # clipboard's), then a flat thumbnails/ beside a pan/ -
                    # both since split by shape into the two directories
                    # above. Regenerating an entry is a second or so, so the
                    # old trees just go rather than being migrated. The find
                    # is what clears the flat layout without touching the
                    # subdirectories that replaced it.
                    rm -rf "$cachedir/wallpapers" "$cachedir/xray" "$cachedir/pan"
                    find "$cachedir/thumbnails" -maxdepth 1 -type f -delete 2>/dev/null
                    # one generation pass at a time: scans are cheap and fire
                    # on every open, and two passes racing on the same cache
                    # entry is duplicated magick work at best
                    exec 9>"$cachedir/.generating"
                    flock -n 9 || exit 0
                    warnedMagick=0
                    warnedFfmpeg=0
                    live=""
                    # walls still missing a renderer capture (see below)
                    capneed=0
                    for f in "$@"; do
                        # Wallpaper Engine walls arrive as directories: bake
                        # from the preview file, but keep every cache key on
                        # the wall dir itself (matching the scan pass above).
                        # Fast path needs no process spawn; odd layouts fall
                        # back to one python for project.json.
                        fsrc="$f"
                        if [ -d "$f" ]; then
                            fsrc=""
                            for cand in "$f"/preview.jpg "$f"/preview.jpeg "$f"/preview.png "$f"/preview.gif "$f"/preview.mp4; do
                                [ -f "$cand" ] && fsrc="$cand" && break
                            done
                            if [ -z "$fsrc" ] && command -v python3 >/dev/null 2>&1; then
                                fsrc=$(python3 -c 'import json,os,sys; d=sys.argv[1]; p=json.load(open(os.path.join(d,"project.json"))); prev=p.get("preview") or ""; print(os.path.join(d,prev) if prev and not os.path.isabs(prev) else prev)' "$f" 2>/dev/null)
                                { [ -n "$fsrc" ] && [ -f "$fsrc" ]; } || fsrc=""
                            fi
                            [ -n "$fsrc" ] || continue
                        fi
                        b=$(basename "$fsrc")
                        stem="\${b%.*}" ext="\${b##*.}"
                        isvid=0; case "\${ext,,}" in mp4) isvid=1 ;; esac
                        # every generated still is png (see the scan pass):
                        # rescaled, never recompressed
                        oext="png"
                        # see the matching key note in the scan pass above
                        # (t5 = 720x405 png crops)
                        key=$(printf '%s' "$f|t5" | md5sum | cut -d' ' -f1)
                        # see the matching pkey note in the scan pass above
                        # (p2 = png wide)
                        pkey=$(printf '%s' "$f|p2" | md5sum | cut -d' ' -f1)
                        # see the matching bkey note in the scan pass above
                        bkey=$(printf '%s' "$f|$xgeom|$xsigma|r5" | md5sum | cut -d' ' -f1)
                        wide="$cachedir/thumbnails/wide/$pkey.png"
                        # Only live-blur keys that are still wanted ride along
                        # for the sweep: xray shows the current wallpaper
                        # alone, so other walls' blurs fall out as duplicates
                        # instead of being kept forever. $BLUR can be any pick,
                        # so it keeps every wall's key (see blurAll).
                        if [ "$blurall" = "1" ] || [ "$f" = "$curwall" ]; then
                            live="$live $key $bkey $pkey"
                        else
                            live="$live $key $pkey"
                        fi
                        # Workshop walls additionally bake a lightweight
                        # looping gif (see below); its key rides along so the
                        # sweep keeps it while the wall exists.
                        akey=""; acache=""
                        if [ -d "$f" ]; then
                            akey=$(printf '%s' "$f|a7" | md5sum | cut -d' ' -f1)
                            acache="$cachedir/animated/$akey.mp4"
                            live="$live $akey"
                            # renderer captures render every wall once (see
                            # capture-wallpapers.sh); missing ones keep the
                            # preview fallback until the capturer lands them.
                            # Video walls never capture (the picker plays the
                            # real file), detected spawn-free by a loose mp4.
                            cap="$capdir/\${f##*/}.webm"
                            isvidwall=0
                            for v in "$f"/*.mp4 "$f"/*.MP4; do
                                [ -f "$v" ] || continue
                                case "$v" in */preview.mp4|*/preview.MP4) continue ;; *) isvidwall=1; break ;; esac
                            done
                            if [ "$isvidwall" = "0" ] && [ "$genon" = "1" ]; then
                                { [ -f "$cap" ] && [ ! "$f/project.json" -nt "$cap" ]; } || capneed=$((capneed + 1))
                            fi
                        fi
                        # Sweep-only pass (previewGeneration off): live keys above
                        # are all the sweep needs - no magick/ffmpeg, no
                        # captures, just the orphan cleanup at the bottom.
                        if [ "$genon" != "1" ]; then
                            continue
                        fi
                        needcrop=0 needblur=0 needwide=0
                        # a video has no crop entry - the wide still stands in
                        # for one everywhere (see the scan pass). Crops are
                        # only drawn by the grid; the carousels never show
                        # them, so baking them there is a duplicate thumbnail
                        # per wall on first open.
                        if [ "$isvid" = "0" ] && [ "$isgrid" = "1" ]; then
                            [ "$cachedir/thumbnails/crops/$key.$oext" -nt "$fsrc" ] || needcrop=1
                        fi
                        # Wides are what the carousels pan across - and what
                        # videos stand in with everywhere. Grid images never
                        # show them, so skip those the same way.
                        if [ "$isgrid" != "1" ] || [ "$isvid" = "1" ]; then
                            [ "$wide" -nt "$fsrc" ] || needwide=1
                        fi
                        # Blurred is read for the current wallpaper alone
                        # (xray backdrop) unless $BLUR can name any pick - so
                        # only bake where it is read instead of once per wall.
                        if [ "$gb" = "1" ] && { [ "$blurall" = "1" ] || [ "$f" = "$curwall" ]; }; then
                            [ "$cachedir/blurred/$bkey.png" -nt "$fsrc" ] || [ -e "$walldir/\${stem}blurred.$ext" ] || needblur=1
                        fi
                        if [ "$needcrop" = "1" ] || [ "$needblur" = "1" ] || [ "$needwide" = "1" ]; then
                            if [ "$isvid" = "1" ]; then
                                if ! command -v ffmpeg >/dev/null 2>&1; then
                                    if [ "$warnedFfmpeg" = "0" ] && [ "$alerts" = "1" ]; then
                                        warnedFfmpeg=1
                                        notify-send -a pibble -i system-software-install "ffmpeg not found" "ffmpeg is used to generate video wallpaper thumbnails and blurred previews - install it for sharper, faster previews."
                                    fi
                                else
                                    # a video's only entry, and it goes in
                                    # wide/ rather than being cropped like the
                                    # images below: this frame is what the
                                    # picker paints while the live video isn't
                                    # playing, and PreserveAspectCrop derives
                                    # its scale from the source aspect, so a
                                    # 16:9 still standing in for a video that
                                    # isn't 16:9 lands at a different crop than
                                    # the video itself - a visible zoom the
                                    # instant playback starts. Keeping the
                                    # source aspect makes the two identical in
                                    # any box.
                                    #
                                    # Capped at 1920 wide rather than a small
                                    # fixed size: this still doesn't only back
                                    # the grid's 240x135 tile (which
                                    # downscales at decode time regardless of
                                    # source size) - the carousel decodes the
                                    # same file at up to ~barHeight tall and
                                    # pans across it. A 480px-wide still
                                    # stretched to fill that box read as
                                    # blurrier than the live video it hands
                                    # off to. min() so a source already
                                    # narrower than 1920 isn't upscaled.
                                    #
                                    # flags=lanczos: ffmpeg's default scaler
                                    # is soft on top of an already-lossy
                                    # source, and unsharp claws a bit of that
                                    # back - a frozen compressed frame reads
                                    # blurrier than the same footage in
                                    # motion even at matched resolution
                                    # (motion masks the quantization/deblock
                                    # softness codecs lean on; playback via
                                    # VideoOutput never shows a truly static
                                    # frame the way this thumbnail does), so
                                    # this only narrows the gap, not closes it.
                                    [ "$needwide" = "1" ] && ffmpeg -y -v error -i "$fsrc" -vframes 1 -vf "scale='min(1920,iw)':-1:flags=lanczos,unsharp=5:5:0.8:5:5:0.0" "$wide"
                                fi
                            elif ! command -v magick >/dev/null 2>&1; then
                                if [ "$warnedMagick" = "0" ] && [ "$alerts" = "1" ]; then
                                    warnedMagick=1
                                    notify-send -a pibble -i system-software-install "magick not found" "ImageMagick is used to generate wallpaper thumbnails and blurred previews - install it for sharper, faster previews."
                                fi
                            else
                                # "$fsrc[0]": first frame only, so an animated
                                # .gif source still yields a static
                                # crop/blur (only live tiles play animation,
                                # see previewAnimOf, never the stills)
                                # 720x405: tiles are 240x135 logical, so this
                                # stays sharp to ~3x device pixels (HiDPI).
                                [ "$needcrop" = "1" ] && magick "$fsrc[0]" -resize 720x405^ -gravity center -extent 720x405 "$cachedir/thumbnails/crops/$key.$oext"
                                # The wide still: the same frame
                                # uncropped, bounded to the box a video's
                                # already gets (see the ffmpeg call above), so
                                # both types feed that strip the same picture
                                # at the same quality. The trailing > only
                                # ever shrinks - a source already smaller
                                # comes through as it is rather than being
                                # upscaled into the cache.
                                #
                                # This exists purely to keep the decode off the
                                # original: a 5K PNG costs ~280ms to decode
                                # even asked for at 440px tall (unlike a JPEG,
                                # PNG has no scaled decode path - the whole
                                # thing is unpacked, then resized), and the
                                # carousel pays that again for every cell that
                                # wraps around the strip. At 1920 wide it is
                                # ~30ms. PNG, like every other variant now:
                                # rescaled only, never recompressed - alpha
                                # rides along instead of being flattened onto
                                # black, which is what a transparent wallpaper
                                # actually composites over.
                                [ "$needwide" = "1" ] && magick "$fsrc[0]" -resize '1920x1080>' "$wide"
                            fi
                        fi
                        # The blurred variant: the wallpaper as the compositor
                        # would blur it behind the launcher (see the xray
                        # block on root for where the numbers come from),
                        # which is also what the wallpaper command gets as
                        # $BLUR. A video goes through the still frame ffmpeg
                        # just wrote, since magick can't read one.
                        #
                        # Cropped to the output's aspect so the launcher's
                        # PreserveAspectCrop has nothing left to crop and the
                        # blur lands at the sigma it was baked for. The crop
                        # rounds to a whole pixel of an image a quarter of the
                        # screen's size, which measures ~3 output pixels below
                        # the compositor's blur of the same wallpaper -
                        # deliberately left as is.
                        if [ "$needblur" = "1" ] && command -v magick >/dev/null 2>&1; then
                            bsrc="$fsrc"
                            [ "$isvid" = "1" ] && bsrc="$wide"
                            [ -e "$bsrc" ] && magick "$bsrc[0]" -resize "$xgeom^" -gravity center -extent "$xgeom" -blur "0x$xsigma" -color-matrix "1.3937 -0.3576 -0.0361, -0.1063 1.1424 -0.0361, -0.1063 -0.3576 1.4639" "$cachedir/blurred/$bkey.png"
                        fi
                        # Workshop walls: bake a small looping mp4 once so
                        # tiles replay instantly instead of decoding the
                        # full-size source on every open. mp4, not gif:
                        # millions of colors and temporal compression read
                        # visibly cleaner at the same bytes. 960px wide:
                        # carousel strips show ~1000 device px on HiDPI, so
                        # narrower bakes would upscale 2x there. 960px,
                        # 12fps, 10s source played at half speed (this setup
                        # runs everything at 50%): setpts doubles frames to
                        # ~20s of slow motion. Motion reads, cost doesn't. Video walls transcode from the full video
                        # (the preview still is static); scenes from the
                        # animated preview gif. Atomic write: tiles only ever
                        # see complete files.
                        if [ -n "$acache" ] && [ ! "$acache" -nt "$fsrc" ]; then
                            asrc="$fsrc"; seek=""; dur="-t 10"
                            # scenes bake at half speed (this setup runs
                            # everything at 50%): fps doubles frames first
                            # so motion stays 12fps, then setpts stretches
                            # the timeline 2x. Videos bake at original speed:
                            # slowing a video would just halve its fps.
                            rate=24; slow=",setpts=2*PTS"
                            if command -v python3 >/dev/null 2>&1; then
                                wmeta=$(python3 -c 'import json,os,sys; d=sys.argv[1]; p=json.load(open(os.path.join(d,"project.json"))); mf=p.get("file") or ""; print((p.get("type") or "").lower()); print(os.path.join(d,mf) if mf and not os.path.isabs(mf) else mf)' "$f" 2>/dev/null) || wmeta=""
                                wtype=$(printf '%s' "$wmeta" | sed -n '1p')
                                wmedia=$(printf '%s' "$wmeta" | sed -n '2p')
                                if [ "$wtype" = "video" ] && [ -n "$wmedia" ] && [ -f "$wmedia" ]; then
                                    asrc="$wmedia"; seek="-ss 0"; dur="-t 10"; rate=12; slow=""
                                fi
                            fi
                            # A renderer capture beats any preview source: it
                            # is the wall itself, at capture resolution. No
                            # version bump needed - landing captures flip
                            # existing bakes via the -nt check below ($cap
                            # was resolved with the cache keys above).
                            if [ -f "$cap" ] && [ ! "$f/project.json" -nt "$cap" ] && [ ! "$acache" -nt "$cap" ]; then
                                asrc="$cap"; seek=""; dur=""
                            fi
                            if command -v ffmpeg >/dev/null 2>&1; then
                                # temp keeps an .mp4 extension: ffmpeg picks
                                # the muxer from it
                                tmp="\${acache%.mp4}.$$.mp4"
                                # min() so sources smaller than the target are
                                # never upscaled. The crop forces even
                                # dimensions (x264 rejects odd sizes, and
                                # Steam serves odd ones like 197px).
                                # crf 18 + slow: previews are tiny on disk
                                # either way, so spend bits, not bytes -
                                # banding/blockiness read instantly at tile
                                # size while the extra encode seconds are a
                                # one-time background cost.
                                # 261-byte lesson: ffmpeg can exit 0 having
                                # written a header-only file (no decodable
                                # frames in range), which then looks newer
                                # than the source forever. Validate content
                                # before adopting: failures just retry next
                                # pass instead of poisoning the cache.
                                # Half speed WITHOUT halving the frame rate:
                                # fps doubles frames first (each input frame
                                # survives, motion stays 12fps), then setpts
                                # stretches the timeline 2x. setpts alone
                                # would just spread the same frames thinner.
                                if ffmpeg -y -v error $seek -i "$asrc" $dur -vf "fps=$rate,scale='min(960,iw)':-2:flags=lanczos,crop='trunc(iw/2)*2':'trunc(ih/2)*2'$slow" -an -c:v libx264 -preset slow -crf 18 -pix_fmt yuv420p -movflags +faststart "$tmp" 2>/dev/null; then
                                    frames=$(ffprobe -v error -count_frames -select_streams v:0 -show_entries stream=nb_read_frames -of csv=p=0 "$tmp" 2>/dev/null | grep -E '^[0-9]+$' || echo 0)
                                    size=$(stat -c%s "$tmp" 2>/dev/null || echo 0)
                                    if [ "$frames" -ge 10 ] 2>/dev/null && [ "$size" -gt 20000 ]; then
                                        mv -f "$tmp" "$acache"
                                    else
                                        rm -f "$tmp"
                                    fi
                                else
                                    rm -f "$tmp"
                                fi
                            elif [ "$warnedFfmpeg" = "0" ] && [ "$alerts" = "1" ]; then
                                warnedFfmpeg=1
                                notify-send -a pibble -i system-software-install "ffmpeg not found" "ffmpeg is used to generate animated wallpaper previews - install it for live Wallpaper Engine tiles."
                            fi
                        fi
                    done
                    # captures missing: start the background capturer (it
                    # singletons on its own lock; this just makes sure one
                    # is going whenever the picker has gaps to fill)
                    if [ "$capneed" -gt 0 ] && [ ! -f "$cachedir/captures/PAUSED" ] && [ -x "$HOME/.config/hypr/scripts/capture-wallpapers.sh" ]; then
                        "$HOME/.config/hypr/scripts/capture-wallpapers.sh" >/dev/null 2>&1 &
                    fi
                    # clips/ is not swept here: the clipboard owns it, keys it
                    # by entry id rather than source path, and prunes it
                    # against clipsMax on its own scan
                    for d in "$cachedir/thumbnails/crops" "$cachedir/thumbnails/wide" "$cachedir/blurred" "$cachedir/animated"; do
                        # with nothing asking for blurred variants the keys
                        # this pass knows are not the ones those files were
                        # baked under, so leave them alone rather than
                        # sweeping the lot: asking again picks them straight
                        # back up, and any entry that really is dead by then
                        # goes with the first sweep that can tell.
                        [ "$d" = "$cachedir/blurred" ] && [ "$gb" != "1" ] && continue
                        # same for animated bakes while the WE integration is
                        # off: no Workshop entries means no akeys in $live,
                        # and sweeping would delete every bake that
                        # re-enabling wants back.
                        [ "$d" = "$cachedir/animated" ] && [ "$weon" != "1" ] && continue
                        for c in "$d"/*; do
                            [ -e "$c" ] || continue
                            k=$(basename "$c"); k="\${k%.*}"
                            case " $live " in *" $k "*) ;; *) rm -f "$c" ;; esac
                        done
                    done`, "_", root.dir, SystemInfo.cacheRoot, wantBlur ? "1" : "0", Settings.alertEnabled("missingDeps") ? "1" : "0",
                    root.xraySize.width + "x" + root.xraySize.height, String(root.xrayCacheSigma),
                    Settings.weEnabled ? "1" : "0", isGrid ? "1" : "0", Settings.currentWallpaper, blurAll ? "1" : "0",
                    Settings.previewGeneration ? "1" : "0"].concat(order));
            }
        }
    }

    // ---------- the blurred wallpaper ----------
    // The client-side blur ("xray", see Settings.bgBlur) draws the wallpaper
    // blurred into the cache alongside its thumbnail (see scan), rather
    // than blurring live every time the launcher opens. niri's own xray mode
    // works the same way, and for the same reason: the wallpaper is the only
    // thing being blurred and it almost never changes, so blurring it once
    // and reusing the result is free from then on. Live blur, by contrast,
    // pays a shader compile plus a screen-sized offscreen pass on the first
    // frame after the layer surface maps - long enough to watch the backdrop
    // turn up late behind a grow reveal. The same file is what a wallpaper
    // command gets as $BLUR (see LauncherWindow.applyWallpaper).
    //
    // The kernel is cloned from niri's defaults (`blur { passes 3; offset 3;
    // noise 0.02; saturation 1.5 }`). Its dual kawase chain - 3 downsample
    // then 3 upsample passes, each tapping at `offset` halves of a
    // destination pixel with the 5/8-tap kernels in
    // src/render_helpers/shaders/blur_{down,up}.frag - has an impulse
    // response indistinguishable from a gaussian of sigma 19.17: simulating
    // the chain and blurring a hard edge with `-blur 0x19.17` both spread it
    // over exactly 50px, 10% to 90%. So one gaussian is the whole chain.
    //
    // Saturation is niri's postprocess step: a mix toward Rec.709 luma,
    // applied to the blurred result in the same non-linear sRGB the blur
    // itself runs in (its textures are plain 8-bit ABGR, no linearization) -
    // which is what -color-matrix does here, and why nothing converts to
    // linear light first. Niri's noise step is the one part deliberately not
    // reproduced: it can't be baked in (this image is upscaled on the way to
    // the screen, so it would land as blotches rather than dither), and the
    // alternative - a noise tile drawn live over the backdrop - is a
    // full-screen texture that also shows as grain over the desktop whenever
    // there's no wallpaper baked to sit under it. The banding it would have
    // hidden is accepted instead.
    //
    // Sigma is niri's radius in *output* pixels. On a fractionally scaled
    // output the compositor hands anyone not speaking wp-fractional-scale a
    // rounded wl_output scale (niri reports 2 for a 1.25x output, which is
    // what a ShellScreen's devicePixelRatio - and a window's, until its
    // surface is mapped - comes back as), so dividing by that lands the blur
    // a long way off. A mapped surface is told the real fractional scale, so
    // that is what gets measured. See XrayScaleProbe.
    readonly property real xraySigma: 19.17
    // Baked at a quarter of the output's logical resolution. A blur this
    // wide leaves nothing that a quarter-rate sampling can't carry: against
    // the same blur done at full output resolution, the quarter-size bake
    // scaled back up measures 55dB PSNR - visually identical, at a sixteenth
    // of the magick run, the file size, the decode and the texture upload.
    readonly property int xrayScale: 4
    readonly property size xraySize: {
        const s = root.screen;
        if (!s)
            return Qt.size(0, 0);
        return Qt.size(Math.max(1, Math.round(s.width / root.xrayScale)), Math.max(1, Math.round(s.height / root.xrayScale)));
    }
    // output pixels per logical pixel, 0 until measured (see
    // XrayScaleProbe). Nothing bakes until it resolves - baking a whole
    // wallpaper folder at the wrong sigma and then again at the right one
    // is minutes of pointless work - but it always resolves, to 1 if the
    // measurement can't be made.
    property real xrayOutputScale: 0
    // Every output measured so far, by name. The launcher follows the
    // compositor's focused output (see LauncherWindow.syncScreen), so `screen`
    // changes whenever it opens on a different monitor - and a different output
    // can have a different fractional scale, which is the unit xraySigma is
    // expressed in, so the measurement has to be made again there. Remembering
    // it per output is what keeps moving *back* free: an unmeasured output
    // spends a probe (~500ms) with the backdrop dropped to the live-blur
    // fallback, since a scale of 0 is also what holds the bake back.
    property var xrayOutputScales: ({})
    onScreenChanged: root.xrayOutputScale = (root.screen ? root.xrayOutputScales[root.screen.name] : 0) ?? 0
    // the blur as it applies to the baked image rather than to the screen:
    // output pixels -> logical pixels -> the quarter-size image. 0 while the
    // scale is unknown, which is what holds the bake back.
    readonly property real xrayCacheSigma: root.xrayOutputScale > 0 ? root.xraySigma / root.xrayOutputScale / root.xrayScale : 0
    // The baked backdrop for the current wallpaper, or "" if there isn't one
    // yet (no ImageMagick, or a folder still being worked through), which
    // falls the launcher back to blurring live.
    readonly property string xrayBlur: {
        if (Settings.bgBlur !== "xray")
            return "";
        const w = root.list.find(x => x.path === Settings.currentWallpaper);
        return w ? w.blur : "";
    }
    // Everything the backdrop could draw, best first: the bake, or - until
    // there is one - the raw wallpaper for the launcher to blur live. That
    // fallback is only worth naming once a scan that was actually looking for
    // the current backdrops has come back without one (see scanKey); before
    // that it is just a full-size wallpaper decode that the bake replaces
    // moments later.
    readonly property string xrayWant: {
        if (Settings.bgBlur !== "xray")
            return "";
        if (root.xrayBlur !== "")
            return root.xrayBlur;
        return root.scanKey === root.xrayCacheKey ? root.matugenSource : "";
    }
    // What the backdrop actually draws, and whether that is the raw wallpaper
    // - i.e. whether the launcher has to blur it itself.
    property string xrayShown: ""
    property bool xrayShownLive: false
    function syncXrayShown() {
        // Only ever swapped while the launcher is down. Two things move it,
        // and neither is watchable mid-open:
        //
        //   - applying a wallpaper leaves the launcher open on the picker,
        //     where the tiles hide the backdrop, so the swap only shows as the
        //     UI fades out on the way to closing - which reads as the backdrop
        //     changing out from under the exit animation.
        //   - the output scale resolving (see XrayScaleProbe, ~1.4s after a
        //     daemon start, and later than that with Settings.preload on)
        //     re-keys every cache entry, walking xrayWant through "" and then
        //     a bake that still has to be decoded. An Image drops what it is
        //     showing the moment its source changes, so on a first open caught
        //     inside that window it is a backdrop-shaped hole under the reveal
        //     - measured 600ms of nothing at all, the decode being that slow
        //     against a first open's busy GUI thread.
        //
        // Drawing nothing is the one thing worse than swapping late, so an
        // empty backdrop takes whatever is going immediately: on a cold cache
        // the alternative is a whole first open with no backdrop at all. Same
        // for a backdrop nobody is looking at, which is what the mode being
        // off makes this.
        if (root.launcherShown && root.xrayShown !== "" && Settings.bgBlur === "xray")
            return;
        root.xrayShownLive = root.xrayWant !== "" && root.xrayBlur === "";
        root.xrayShown = root.xrayWant;
    }
    onXrayWantChanged: root.syncXrayShown()
    // Everything the baked files are named after. A new output geometry or
    // scale (or switching the mode on at all) changes every name, so the
    // scan has to run again to generate the new ones and sweep the old.
    readonly property string xrayCacheKey: (Settings.bgBlur === "xray" || Settings.wallCommand.includes("$BLUR") ? "on" : "off")
        + "|" + root.xraySize.width + "x" + root.xraySize.height + "|" + root.xrayCacheSigma
    onXrayCacheKeyChanged: root.rescan()

    // Measures the output scale that xraySigma needs, once, off the device
    // pixel ratio of a mapped surface (see XrayScaleProbe). Only ever runs in
    // "xray" mode, and the surface it needs to exist on goes away the moment
    // the number lands. A compositor that never reports one just leaves the
    // timeout below to settle it at 1, i.e. logical pixels stand in for output
    // pixels, which is exactly right on an unscaled output.
    readonly property bool xrayScaleWanted: (Settings.bgBlur === "xray" || Settings.wallCommand.includes("$BLUR"))
        && root.xrayOutputScale === 0 && root.screen !== null
    // `output` is the name of the output the measurement was taken on, which is
    // not necessarily the one in use by the time it lands: the probe settles on
    // a debounce (see XrayScaleProbe), and the launcher can move to another
    // monitor inside that window.
    function setXrayOutputScale(s, output) {
        // a bad measurement (a surface that never mapped, a screen that
        // resized mid-measure) must still resolve to something, or nothing
        // would ever bake
        const scale = s > 0.1 ? s : 1;
        // mutated in place deliberately - nothing binds to the map, it is only
        // ever read back on a screen change
        if (output)
            root.xrayOutputScales[output] = scale;
        // a measurement for an output that is no longer the one in use is worth
        // filing but not applying; the probe is already re-running against the
        // current one, and adopting this would bake the folder at its sigma
        if (!output || !root.screen || output === root.screen.name)
            root.xrayOutputScale = scale;
    }
    Timer {
        id: xrayScaleTimeout
        interval: 3000
        running: root.xrayScaleWanted
        onTriggered: root.setXrayOutputScale(1, root.screen ? root.screen.name : "")
    }
}
