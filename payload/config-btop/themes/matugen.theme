# Matugen btop theme - auto-generated, do not edit directly
# Source: ~/.config/matugen/templates/btop.theme
# Output: ~/.config/btop/themes/matugen.theme

# Main background (ignored when theme_background=False, falls back to terminal transparency)
theme[main_bg]="#19120d"

# Main text color
theme[main_fg]="#f0dfd7"

# Title color for boxes
theme[title]="#f0dfd7"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#ffb786"

# Background color of selected items
theme[selected_bg]="#6e390d"

# Foreground color of selected items
theme[selected_fg]="#ffdcc6"

# Color of inactive/disabled text
theme[inactive_fg]="#9f8d83"

# Color of text appearing on top of graphs
theme[graph_text]="#d7c3b7"

# Misc colors for processes box
theme[proc_misc]="#e4bfa8"

# Cpu box outline color
theme[cpu_box]="#9f8d83"

# Memory/disks box outline color
theme[mem_box]="#9f8d83"

# Net up/down box outline color
theme[net_box]="#9f8d83"

# Processes box outline color
theme[proc_box]="#9f8d83"

# Box divider line and small boxes line color
theme[div_line]="#52443c"

# Temperature graph colors (cool -> hot)
theme[temp_start]="#ffb786"
theme[temp_mid]="#e4bfa8"
theme[temp_end]="#ffb4ab"

# CPU graph colors (cool -> hot)
theme[cpu_start]="#ffb786"
theme[cpu_mid]="#e4bfa8"
theme[cpu_end]="#ffb4ab"

# Mem/Disk free meter (low free=error, high free=primary)
theme[free_start]="#ffb4ab"
theme[free_mid]="#e4bfa8"
theme[free_end]="#ffb786"

# Mem/Disk cached meter
theme[cached_start]="#ffb786"
theme[cached_mid]="#e4bfa8"
theme[cached_end]="#c9ca94"

# Mem/Disk available meter (same logic as free)
theme[available_start]="#ffb4ab"
theme[available_mid]="#e4bfa8"
theme[available_end]="#ffb786"

# Mem/Disk used meter (low used=primary, high used=error)
theme[used_start]="#ffb786"
theme[used_mid]="#e4bfa8"
theme[used_end]="#ffb4ab"

# Download graph colors
theme[download_start]="#ffb786"
theme[download_mid]="#e4bfa8"
theme[download_end]="#c9ca94"

# Upload graph colors
theme[upload_start]="#ffb786"
theme[upload_mid]="#e4bfa8"
theme[upload_end]="#c9ca94"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#ffb786"
theme[process_mid]="#e4bfa8"
theme[process_end]="#ffb4ab"
