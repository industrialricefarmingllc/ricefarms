# Matugen btop theme - auto-generated, do not edit directly
# Source: ~/.config/matugen/templates/btop.theme
# Output: ~/.config/btop/themes/matugen.theme

# Main background (ignored when theme_background=False, falls back to terminal transparency)
theme[main_bg]="#fff8f7"

# Main text color
theme[main_fg]="#231919"

# Title color for boxes
theme[title]="#231919"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#904a4a"

# Background color of selected items
theme[selected_bg]="#ffdad8"

# Foreground color of selected items
theme[selected_fg]="#3b080c"

# Color of inactive/disabled text
theme[inactive_fg]="#857372"

# Color of text appearing on top of graphs
theme[graph_text]="#524343"

# Misc colors for processes box
theme[proc_misc]="#775655"

# Cpu box outline color
theme[cpu_box]="#857372"

# Memory/disks box outline color
theme[mem_box]="#857372"

# Net up/down box outline color
theme[net_box]="#857372"

# Processes box outline color
theme[proc_box]="#857372"

# Box divider line and small boxes line color
theme[div_line]="#d7c1c0"

# Temperature graph colors (cool -> hot)
theme[temp_start]="#904a4a"
theme[temp_mid]="#775655"
theme[temp_end]="#ba1a1a"

# CPU graph colors (cool -> hot)
theme[cpu_start]="#904a4a"
theme[cpu_mid]="#775655"
theme[cpu_end]="#ba1a1a"

# Mem/Disk free meter (low free=error, high free=primary)
theme[free_start]="#ba1a1a"
theme[free_mid]="#775655"
theme[free_end]="#904a4a"

# Mem/Disk cached meter
theme[cached_start]="#904a4a"
theme[cached_mid]="#775655"
theme[cached_end]="#745a2f"

# Mem/Disk available meter (same logic as free)
theme[available_start]="#ba1a1a"
theme[available_mid]="#775655"
theme[available_end]="#904a4a"

# Mem/Disk used meter (low used=primary, high used=error)
theme[used_start]="#904a4a"
theme[used_mid]="#775655"
theme[used_end]="#ba1a1a"

# Download graph colors
theme[download_start]="#904a4a"
theme[download_mid]="#775655"
theme[download_end]="#745a2f"

# Upload graph colors
theme[upload_start]="#904a4a"
theme[upload_mid]="#775655"
theme[upload_end]="#745a2f"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#904a4a"
theme[process_mid]="#775655"
theme[process_end]="#ba1a1a"
