#!/bin/sh
# hypr-inputs-ready — exit 0 once Hyprland IPC answers AND at least one input
# device is registered. Gates quickshell/pibble spawns: a Qt client starting
# while the compositor is master-less (boot race, VT-switch handoff gap) can
# steal DRM master, bricking every modeset (black screens + EPERM). Seen
# 2026-09-06 twice (qs with foreign/stale session env holding card1 master).
#
# 2026-11-17: Hyprland 0.57.1 can answer IPC with an empty device list even
# when the session is healthy (seen after a VT switch: `hyprctl devices -j`
# returns empty arrays while the desktop keeps rendering). When no devices are
# exposed at all, fall back to "IPC answers and a monitor is enabled", which
# still proves the compositor owns the DRM device.
# Usage: hypr-inputs-ready [tries]   (one try ~2s; default 15 = ~30s)
tries="${1:-15}"
i=0
while [ "$i" -lt "$tries" ]; do
  SIG=$(hyprctl instances 2>/dev/null | awk '/^instance /{print $2}' | tr -d ':' | head -n1)
  if [ -n "$SIG" ]; then
    N=$(HYPRLAND_INSTANCE_SIGNATURE="$SIG" hyprctl devices -j 2>/dev/null | python3 -c "import json,sys; d=json.load(sys.stdin); print(sum(len(d.get(k,[])) for k in ('mice','keyboards','tablets','touch','switches')))" 2>/dev/null || echo 0)
    if [ "${N:-0}" -gt 0 ] 2>/dev/null; then exit 0; fi
    # Empty device list: accept an enabled monitor as the readiness signal.
    MON=$(HYPRLAND_INSTANCE_SIGNATURE="$SIG" hyprctl monitors -j 2>/dev/null | python3 -c "import json,sys; print(sum(1 for m in json.load(sys.stdin) if m.get('width') and m.get('height')))" 2>/dev/null || echo 0)
    if [ "${N:-0}" -eq 0 ] && [ "${MON:-0}" -gt 0 ] 2>/dev/null; then exit 0; fi
  fi
  i=$(( i + 1 ))
  sleep 2
done
exit 1
