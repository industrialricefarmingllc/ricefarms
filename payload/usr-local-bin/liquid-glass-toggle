#!/bin/bash
# liquid-glass-toggle — master switch for the liquid-glass-hypr plugin.
#
# What it toggles (entirely):
#   - layer glass (bar/dock/osd/pibble circle, namespaces=quickshell)
#   - window glass (windows="*", kitty/zen takeover + rim overdraw)
#   - glass borders / frames / window-shadow suppression
#   - goo workspace morph (same .so, plugin:gooworkspaces:enabled)
#   - QML fallback: bar/dock revert to solid Theme.bg + QML shadows
#     (externalGlass follows Prefs.liquidGlassEnabled — see shell.qml/Dock.qml)
#
# How (crash-safe):
#   - NEVER `hyprctl plugin unload` — unloading this .so live SEGVs the
#     compositor (GL teardown off-context, see src/liquid-glass-hypr/README
#     and hyprland.lua). We only flip the in-render-pass early-outs:
#       prefs.json liquidGlassEnabled (plugin tuner, mtime-gated per frame)
#       + hl.config plugin.liquidglass.enabled (belt-and-braces)
#       + hl.config plugin.gooworkspaces.enabled (no prefs twin)
#     Hooks stay loaded, they just return early = ~zero GPU.
#   - Screen shader (main.glsl color-grade) is untouched — not liquid glass.
#
# State: prefs.json is the source of truth (persists across reload/reboot).
# Goo follows glass (off->off, on->on); a config.reloaded handler in
# custom.lua re-applies goo=0 after matugen reloads while glass is off.
#
# Usage: liquid-glass-toggle [--toggle|--on|--off|--status|--help]

set -u
PREFS="${HOME:-/home/nicerice}/.config/quickshell/lucidprefs/prefs.json"
DEFAULT_ON=true

usage() {
  echo "Usage: $(basename "$0") [--toggle|--on|--off|--status|--help]"
  echo "  (no args) / --toggle : flip liquid glass entirely (GPU saver, no unload)"
  echo "  --on                 : enable liquid glass + goo morph"
  echo "  --off                : disable liquid glass + goo morph"
  echo "  --status             : print on/off (+ goo state)"
  echo "  --help               : this help"
}

# --- read current state (prefs.json wins; default on) ---
current_state() {
  if [ -f "$PREFS" ]; then
    # jq preferred; python fallback; grep last resort. Missing key = on.
    # NOTE: `.x // true` is WRONG here — jq's // treats false as missing
    # and would report `false` as on. Use explicit null check instead.
    if command -v jq >/dev/null 2>&1; then
      v=$(jq -r 'if .liquidGlassEnabled == false then "false" else "true" end' "$PREFS" 2>/dev/null) || v="true"
      [ "$v" = "false" ] && echo "off" || echo "on"
      return
    fi
    if command -v python3 >/dev/null 2>&1; then
      v=$(python3 -c "import json,sys;print(json.load(open('$PREFS')).get('liquidGlassEnabled',True))" 2>/dev/null) || v="True"
      [ "$v" = "False" ] && echo "off" || echo "on"
      return
    fi
    if grep -q '"liquidGlassEnabled"[[:space:]]*:[[:space:]]*false' "$PREFS" 2>/dev/null; then
      echo "off"; return
    fi
  fi
  echo "on"
}

# --- write prefs.json atomically, preserving all other keys ---
write_prefs() { # $1 = true|false (json bool)
  local val="$1" tmp
  mkdir -p "$(dirname "$PREFS")"
  if [ ! -f "$PREFS" ]; then
    printf '{"liquidGlassEnabled": %s}\n' "$val" > "$PREFS"
    return $?
  fi
  if command -v jq >/dev/null 2>&1; then
    tmp=$(mktemp "$(dirname "$PREFS")/.prefs.XXXXXX") || return 1
    if jq --argjson v "$val" '.liquidGlassEnabled = $v' "$PREFS" > "$tmp" 2>/dev/null; then
      mv -f "$tmp" "$PREFS"
      return 0
    fi
    rm -f "$tmp"; return 1
  fi
  # python fallback (preserves formatting loosely, keeps all keys)
  python3 - "$PREFS" "$val" <<'EOF'
import json, sys
path, val = sys.argv[1], sys.argv[2] == 'true'
with open(path) as f:
    try: data = json.load(f)
    except Exception: data = {}
data['liquidGlassEnabled'] = val
with open(path, 'w') as f:
    json.dump(data, f, indent=4)
    f.write('\n')
EOF
}

# --- live-apply to the running compositor (best-effort, never fatal) ---
apply_live() { # $1 = 0|1 (0=off, 1=on)
  local en="$1" ok=0
  if ! command -v hyprctl >/dev/null 2>&1; then return 1; fi
  # liquidglass master switch (belt-and-braces: prefs tuner already covers it)
  hyprctl eval "hl.config({plugin={liquidglass={enabled=$en}}})" >/dev/null 2>&1 || ok=1
  # goo morph (no prefs twin — this is the only path)
  hyprctl eval "hl.config({plugin={gooworkspaces={enabled=$en}}})" >/dev/null 2>&1 || ok=1
  return $ok
}

notify() { # $1 = message
  command -v hyprctl >/dev/null 2>&1 && hyprctl notify 5 2500 0 "$1" >/dev/null 2>&1 || true
}

set_state() { # $1 = on|off
  local want="$1" en json_bool label
  if [ "$want" = "on" ]; then en=1; json_bool=true; label="ON"; else en=0; json_bool=false; label="OFF"; fi
  if ! write_prefs "$json_bool"; then
    echo "liquid-glass-toggle: ERROR: failed to write $PREFS" >&2
    return 1
  fi
  if ! apply_live "$en"; then
    echo "liquid-glass-toggle: glass $label (prefs written; compositor IPC unavailable — applies on next Hyprland start/reload)" >&2
  elif [ "$want" = "on" ]; then
    echo "liquid glass: $label (no reload/unload — hooks active, glass restored)"
  else
    echo "liquid glass: $label (no unload — hooks idle, QML fallback active)"
  fi
  notify "liquid glass $label"
}

CMD="${1:-}"
[ -z "$CMD" ] && CMD="--toggle"
case "$CMD" in
  --help|-h|help)
    usage; exit 0 ;;
  --status|status)
    st=$(current_state)
    goo=""
    if command -v hyprctl >/dev/null 2>&1; then
      goo=$(hyprctl getoption plugin:gooworkspaces:enabled 2>/dev/null | rg -o 'int: [01]' || true)
    fi
    echo "liquid glass: $st"
    [ -n "$goo" ] && echo "goo: $goo"
    exit 0
    ;;
  --on|on|enable|start)
    set_state on ;;
  --off|off|disable|stop)
    set_state off ;;
  --toggle|toggle|"")
    if [ "$(current_state)" = "on" ]; then set_state off; else set_state on; fi
    ;;
  *)
    echo "liquid-glass-toggle: unknown arg '$CMD'" >&2
    usage >&2; exit 2 ;;
esac
