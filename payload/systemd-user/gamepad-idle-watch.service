[Unit]
Description=Gamepad activity watcher for hypridle
Documentation=file:%h/.local/bin/gamepad-idle-watch
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/gamepad-idle-watch
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
