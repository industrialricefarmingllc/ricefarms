{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "**/.cache/**": "deny",
      "**/.local/share/Steam/**": "deny",
      "**/.steam/**": "deny"
    },
    "glob": {
      "*": "allow",
      "**/.cache/**": "deny",
      "**/.local/share/Steam/**": "deny",
      "**/.steam/**": "deny"
    },
    "grep": {
      "*": "allow",
      "**/.cache/**": "deny",
      "**/.local/share/Steam/**": "deny",
      "**/.steam/**": "deny"
    },
    "list": {
      "*": "allow",
      "**/.cache/**": "deny",
      "**/.local/share/Steam/**": "deny",
      "**/.steam/**": "deny"
    }
  },
  "watcher": {
    "ignore": [
      "**/.cache/**",
      "**/.local/share/Steam/**",
      "**/.steam/**"
    ]
  }
}