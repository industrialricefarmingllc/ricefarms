# large binaries live in payload-large/ via Git LFS (see .gitattributes) —
# clone with `git lfs pull` (or plain `git clone`, smudge does it) and the
# installer finds them. Do NOT add raw tarballs outside LFS.
# hyprland crash reports / caches accidentally exported
payload/**/hyprlandCrashReport*.txt
# OS dreck
.DS_Store

# python bytecode from payload helpers (export prunes these)
__pycache__/
*.pyc
# hypr plugin build artifacts (rebuilt by install.sh's build steps)
payload/hypr-edge-swipe/*.so
payload/hypr-edge-swipe/src/*.o
payload/liquid-glass-hypr/*.so
payload/liquid-glass-hypr/src/*.o
payload/liquid-glass-hypr-057/*.so
payload/liquid-glass-hypr-057/src/*.o
